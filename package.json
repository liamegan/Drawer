{
  "name": "wtc-drawer",
  "version": "0.0.0",
  "description": "A plotter-oriented vector generative art library: millimetre sheets, pen layers, seeded randomness and SVG export.",
  "type": "module",
  "author": "Liam Egan <liam@wethecollective.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamegan/Drawer.git"
  },
  "homepage": "https://liamegan.github.io/Drawer/",
  "bugs": {
    "url": "https://github.com/liamegan/Drawer/issues"
  },
  "keywords": [
    "generative",
    "plotter",
    "svg",
    "vector",
    "pen-plotter",
    "creative-coding"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "docs": "npm --prefix tools/typedoc install --no-audit --no-fund --silent && tools/typedoc/node_modules/.bin/typedoc --options tools/typedoc/typedoc.json",
    "gallery": "node tools/gallery.ts"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.6",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wtc-math": "^1.4.0"
  },
  "peerDependencies": {
    "wtc-math": "^1.4.0"
  }
}
